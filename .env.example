# Auth.js server-side session secret. Generate a strong random value per environment.
AUTH_SECRET="replace-with-a-random-secret"

# GitHub OAuth App credentials. Never commit real values.
# Local OAuth callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# PostgreSQL server persistence. Production connections must enforce TLS.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_copilot"
