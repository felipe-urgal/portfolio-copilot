# Auth.js server-side session secret. Generate a strong random value per environment.
AUTH_SECRET="replace-with-a-random-secret"

# GitHub OAuth App credentials. Never commit real values.
# Local OAuth callback: http://localhost:5300/api/auth/callback/github
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# In production, restrict sign-in to one GitHub account id. Local development may omit it.
AUTH_GITHUB_ALLOWED_ACCOUNT_ID="replace-with-github-account-id"

# PostgreSQL server persistence. Local Docker Compose binds only to 127.0.0.1:5433.
# Runtime production connections should use the pooled provider URL and enforce TLS.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio_copilot"

# Production migrations use a direct/unpooled provider URL.
# Keep this empty for local development unless you intentionally want to exercise prod:migrate.
DATABASE_DIRECT_URL=""

# Canonical production readiness URL. Configure only in the production environment.
PORTFOLIO_COPILOT_PRODUCTION_READY_URL="https://portfolio-copilot.example/api/health/ready"
