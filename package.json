{
  "name": "portfolio-copilot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio-copilot/web dev",
    "db:generate": "pnpm --filter @portfolio-copilot/persistence db:generate",
    "db:migrate": "pnpm --filter @portfolio-copilot/persistence db:migrate",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"*.{json,yaml,yml,mjs}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"*.{json,yaml,yml,mjs}\" \".github/**/*.yml\"",
    "lint": "eslint apps packages --max-warnings=0",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
