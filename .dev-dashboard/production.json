{
  "version": 1,
  "production": {
    "enabled": true,
    "strategy": "git-managed",
    "provider": "vercel",
    "branch": "main",
    "documentation": "docs/PRODUCTION.md",
    "commands": {
      "check": "prod:check",
      "migrate": "prod:migrate",
      "verify": "prod:verify"
    },
    "health": {
      "type": "http",
      "url": "https://portfolio-copilot-plum.vercel.app/api/health/ready"
    },
    "external": {
      "project": "portfolio-copilot"
    },
    "policies": {
      "backup": "external",
      "migrations": "before-deploy",
      "rollback": "manual-restore"
    }
  }
}
